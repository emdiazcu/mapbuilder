APP_NAME=MapBuilder
APP_ENV=production
APP_KEY=                          # Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mapbuilder_db
DB_USERNAME=mapbuilder
DB_PASSWORD=secret               # Change in production

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
BROADCAST_CONNECTION=log

SANCTUM_STATEFUL_DOMAINS=localhost
FRONTEND_URL=http://localhost

BCRYPT_ROUNDS=12
